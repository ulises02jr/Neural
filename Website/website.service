[Unit]
Description=NeuralWorship Website - Flask (landing + productos)
After=network.target

[Service]
User=charts
Group=charts
WorkingDirectory=/home/charts/website
ExecStart=/home/charts/website/venv/bin/gunicorn --workers 2 --timeout 60 --bind 127.0.0.1:5052 --access-logfile - --error-logfile - app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
